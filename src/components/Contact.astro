---
import { FiMail, FiPhone, FiMapPin, FiClock } from 'react-icons/fi';
import Reveal from './islands/Reveal.jsx';
import ContactForm from './islands/ContactForm.jsx';
---
<section class="py-32 bg-black text-white" id="contact">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <Reveal
      client:load
      initial={{ opacity: 0, y: 30 }}
      whileInView={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.8 }}
      className="mb-24"
    >
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-8 tracking-tight">
        Let's Work Together
      </h2>
      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl">
        Ready to start your project? I'd love to hear about your ideas and discuss how we can bring them to life.
      </p>
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <ContactForm client:load />

      <Reveal
        client:load
        initial={{ opacity: 0, x: 30 }}
        whileInView={{ opacity: 1, x: 0 }}
        transition={{ duration: 0.8 }}
      >
        {/* space-y-12 moved inside: Astro's display:contents slot wrapper would block the child selector */}
        <div class="space-y-12">
          <div>
            <h3 class="text-2xl font-bold text-white mb-6">Get in Touch</h3>
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <FiMail className="h-6 w-6 text-gray-400 mt-1" />
                <div>
                  <div class="text-sm text-gray-400 mb-1">Email</div>
                  <a href="mailto:hola@sampsonjoey.com" class="text-lg text-white hover:text-gray-300 transition-colors">
                    hola@sampsonjoey.com
                  </a>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <FiPhone className="h-6 w-6 text-gray-400 mt-1" />
                <div>
                  <div class="text-sm text-gray-400 mb-1">Phone</div>
                  <a href="tel:+15551234567" class="text-lg text-white hover:text-gray-300 transition-colors">
                    +1 (555) 123-4567
                  </a>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <FiMapPin className="h-6 w-6 text-gray-400 mt-1" />
                <div>
                  <div class="text-sm text-gray-400 mb-1">Location</div>
                  <div class="text-lg text-white">Austin, TX</div>
                </div>
              </div>
              
              <div class="flex items-start space-x-4">
                <FiClock className="h-6 w-6 text-gray-400 mt-1" />
                <div>
                  <div class="text-sm text-gray-400 mb-1">Availability</div>
                  <div class="text-lg text-white">Monday - Friday, 9am - 6pm CST</div>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-white mb-6">Response Time</h3>
            <p class="text-gray-300 leading-relaxed">
              I typically respond within 24 hours. For urgent projects or questions, 
              feel free to call directly and I'll get back to you as soon as possible.
            </p>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-white mb-6">What's Next?</h3>
            <div class="space-y-4 text-gray-300">
              <div class="flex items-start space-x-3">
                <span class="text-white font-bold">01</span>
                <span>I'll review your project details and get back to you</span>
              </div>
              <div class="flex items-start space-x-3">
                <span class="text-white font-bold">02</span>
                <span>We'll schedule a call to discuss your requirements</span>
              </div>
              <div class="flex items-start space-x-3">
                <span class="text-white font-bold">03</span>
                <span>I'll provide a detailed proposal and timeline</span>
              </div>
              <div class="flex items-start space-x-3">
                <span class="text-white font-bold">04</span>
                <span>Upon approval, we'll begin the development process</span>
              </div>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
