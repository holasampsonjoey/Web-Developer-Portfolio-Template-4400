---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found - Sampson Joey">
  <main class="min-h-screen flex items-center bg-white px-6 lg:px-12">
    <div class="max-w-7xl mx-auto w-full">
      <p class="text-sm uppercase tracking-widest mb-4 text-gray-500">404</p>
      <h1 class="text-6xl md:text-8xl font-bold text-black mb-8 tracking-tight leading-none">
        Page not found
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 mb-16 max-w-3xl leading-relaxed">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a
        href="/"
        class="inline-block bg-black text-white px-12 py-4 text-lg font-medium hover:bg-gray-800 transition-colors"
      >
        Back to Home
      </a>
    </div>
  </main>
</Base>
